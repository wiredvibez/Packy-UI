# Neon Postgres pooled URL (injected by the Vercel Marketplace Neon integration).
# Used by the app at runtime.
DATABASE_URL=

# Direct Neon URL for migrations. The Marketplace injects this too.
# `db:migrate` prefers it and falls back to DATABASE_URL.
# DATABASE_URL_UNPOOLED=

# Shared secret for the Packy ingest agent. Send as header: x-packy-key
PACKY_INGEST_KEY=

# Single-user passcode. Compared via SHA-256 + timing-safe equal.
PACKY_PASSCODE=

# At least 16 characters. Signs the httpOnly session cookie.
SESSION_SECRET=

# Optional. Included in the session cookie. Defaults to 1.
# Set a new value (for example 2) and redeploy to sign every browser out.
# SESSION_VERSION=1

# Optional. Used for metadata / OG URLs.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. Set to 1 to skip migrations during `next build`.
# SKIP_DB_MIGRATE=
